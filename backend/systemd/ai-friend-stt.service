[Unit]
Description=AI Friend Rust STT Agent (Whisper CUDA)
After=network.target docker.service ai-friend-backend.service

[Service]
Type=simple
User=aniket
WorkingDirectory=/home/aniket/AI_friend/backend
EnvironmentFile=/home/aniket/AI_friend/backend/.env
Environment=STT_MODEL_DIR=/home/aniket/AI_friend/backend/models/whisper
Environment=STT_SENSEVOICE_DIR=/home/aniket/AI_friend/backend/models/sensevoice
Environment=LD_LIBRARY_PATH=/home/aniket/AI_friend/backend/target/release
ExecStart=/home/aniket/AI_friend/backend/target/release/stt-agent
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
