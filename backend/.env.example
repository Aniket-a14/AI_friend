# Core Settings
DEBUG=False
AI_NAME=AI Friend
LOCATION_CONTEXT=Home

# Security
LAN_ONLY=true
ALLOWED_ORIGINS=http://127.0.0.1:3000

# Service Discovery (Internal Docker Mesh)
NATS_URL=nats://nats_mesh:4222
LIVEKIT_URL=ws://local_sfu:7880
OLLAMA_URL=http://host.docker.internal:11434
SOVITS_URL=http://local_voice:9871

# API Keys (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Third-Party Sensors
PORCUPINE_ACCESS_KEY=your_picovoice_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Database (PostgreSQL with PGVector)
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://ai_friend:${POSTGRES_PASSWORD}@postgres_db:5432/ai_friend_db

# Knowledge Graph (Neo4j)
NEO4J_AUTH=neo4j/your_secure_password_here
NEO4J_PLUGINS='["apoc"]'

# Cache (Redis)
REDIS_URL=redis://brain_cache:6379

# Semantic Vector Store (Qdrant)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# AI Model Tuning
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_LANGUAGE=en
TTS_LANGUAGE=en
CUSTOM_GPT_PATH=GPT_weights/ai_friend_voice.ckpt
CUSTOM_SOVITS_PATH=SoVITS_weights/ai_friend_voice.pth
VOICE_WEIGHT_LOAD_RETRIES=3
VOICE_FILLER_HYDRATE_ON_STARTUP=true
SAMPLE_RATE=32000
VOICE_FILLER_THRESHOLD=0.25

# Voice Emotion Reference Clips (voice-agent) -- see the top-level
# .env.example for the full explanation. All optional; unset behaves exactly
# like the single-clip setup before this feature existed.
# REF_AUDIO_PATH=output/sample_en_gold.wav
# REF_TEXT=At the end of the exam, the program shows the performance summary.
# REF_AUDIO_PATH_CALM=output/calm.wav
# REF_TEXT_CALM=transcript of the calm reference clip
# REF_AUDIO_PATH_WARM=output/warm.wav
# REF_TEXT_WARM=transcript of the warm reference clip
# REF_AUDIO_PATH_CONCERNED=output/concerned.wav
# REF_TEXT_CONCERNED=transcript of the concerned reference clip
# REF_AUDIO_PATH_EXCITED=output/excited.wav
# REF_TEXT_EXCITED=transcript of the excited reference clip

# Voice Reliability (voice-agent) -- no fallback to a different engine/voice;
# these only govern same-engine recovery. Defaults shown are what the code
# uses if unset.
# TTS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# TTS_CIRCUIT_BREAKER_COOLDOWN_MS=15000
# TTS_READINESS_PROBE_INTERVAL_SECS=45
