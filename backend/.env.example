# Core Settings
DEBUG=False
AI_NAME=AI Friend
LOCATION_CONTEXT=Home

# Security
ALLOWED_ORIGINS=http://localhost:3000

# Service Discovery (Internal Docker Mesh)
# These default to the service names in docker-compose.yml
NATS_URL=nats://nats:4222
LIVEKIT_URL=http://livekit:7880
OLLAMA_URL=http://ollama:11434
SOVITS_URL=http://sovits:9871

# API Keys (Required)
GEMINI_API_KEY=your_gemini_key_here
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-at-least-thirty-two-characters-long

# Database (PostgreSQL with PGVector)
# For local development with docker-compose.infra.yml:
DATABASE_URL=postgresql://ai_friend:dev_password_change_in_prod@postgres:5432/ai_friend_db

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dev_password_change_in_prod

# Cache (Redis - Optional)
REDIS_URL=redis://redis:6379

# AI Model Tuning
STT_MODEL_SIZE=small
STT_DEVICE=cpu
SAMPLE_RATE=16000
