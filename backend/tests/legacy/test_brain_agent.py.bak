"""
Test script for local BrainAgent functionality
"""
import asyncio
import nats
import json
import os
import sys

# Add backend to path
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

async def test_brain():
    print("🚀 Connecting to NATS...")
    nc = await nats.connect("nats://localhost:4222")
    js = nc.jetstream()

    print("📡 Sending test message to chat.input...")
    test_msg = {
        "text": "Hey! How are you doing today?",
        "session_id": "test_session"
    }

    await js.publish("chat.input", json.dumps(test_msg).encode())

    print("👂 Waiting for response on chat.output...")
    sub = await js.subscribe("chat.output")

    response_received = False
    try:
        while True:
            msg = await sub.next_msg(timeout=60)
            data = json.loads(msg.data.decode())
            chunk = data.get("chunk", "")
            done = data.get("done", False)

            if chunk:
                print(chunk, end="", flush=True)

            if done:
                print("\n\n✅ Response complete!")
                response_received = True
                break
    except asyncio.TimeoutError:
        print("\n❌ Timeout waiting for response")

    await nc.close()
    if not response_received:
        sys.exit(1)

if __name__ == "__main__":
    asyncio.run(test_brain())
