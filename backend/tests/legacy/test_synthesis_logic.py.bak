
import asyncio
import os
import sys
import logging

# Add backend to path
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from app.tts.sovits_client import SoVITSClient

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

async def test_synthesis():
    client = SoVITSClient(base_url="http://localhost:9871")

    # Path inside the container mount
    # backend/voice_samples is mounted to /workspace/GPT-SoVITS/output in docker-compose?
    # No, I changed it to:
    # - voice_samples:/workspace/GPT-SoVITS/output
    # But wait, named volumes are different.

    # Let's check docker-compose.infra.yml again for volume mappings

    ref_audio = "/workspace/GPT-SoVITS/output/sample_hi_1_short.wav"
    ref_text = "Bhai chill mar, chill marr, avehii, faltu main itna sochi ja raha hai, avehi, mat socha kar bhai."
    target_text = "Dost, tension mat le, AI Friend hamesha tere saath hai. Hum milkar sab theek kar lenge!"

    logger.info(f"🚀 Testing synthesis with {ref_audio}")

    output_path = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "voice_samples", "test_output_hi.wav")

    try:
        audio_data = b""
        async for chunk in client.synthesize_stream(
            text=target_text,
            ref_audio_path=ref_audio,
            ref_text=ref_text,
            text_lang="zh", # 'zh' stands for Hindi in some GPT-SoVITS versions for Romanized text
            ref_lang="zh"
        ):
            if chunk:
                audio_data += chunk

        if audio_data:
            with open(output_path, "wb") as f:
                f.write(audio_data)
            logger.info(f"✅ Synthesis successful! Saved to {output_path}")
        else:
            logger.error("❌ Synthesis produced no audio data.")

    except Exception as e:
        logger.error(f"❌ Synthesis failed: {e}")

if __name__ == "__main__":
    asyncio.run(test_synthesis())
