# 🎙️ optimized GPT-SoVITS Inference Image
# Targeted for RTX-series GPUs (2060 Super+)

FROM xxxxrt666/gpt-sovits:cu126-20260209-e4ae04

# 1. Bake in GPT-SoVITS runtime patches for resilient audio I/O
# - Avoid importing torchaudio hard-fail paths when CUDA build metadata drifts.
# - Replace torchaudio.load with scipy wav read (existing infra behavior).
RUN python - <<'PY'
from pathlib import Path

p = Path("/workspace/GPT-SoVITS/GPT_SoVITS/TTS_infer_pack/TTS.py")
c = p.read_text()

c = c.replace(
    "import torchaudio",
    "try:\n    import torchaudio\nexcept Exception:\n    torchaudio = None",
)

c = c.replace(
    '''def resample(audio_tensor, sr0, sr1, device):
    global resample_transform_dict
    key = "%s-%s-%s" % (sr0, sr1, str(device))
    if key not in resample_transform_dict:
        resample_transform_dict[key] = torchaudio.transforms.Resample(sr0, sr1).to(device)
    return resample_transform_dict[key](audio_tensor)
''',
    '''def resample(audio_tensor, sr0, sr1, device):
    global resample_transform_dict
    if torchaudio is None:
        audio_np = audio_tensor.detach().cpu().numpy()
        if audio_np.ndim == 2 and audio_np.shape[0] == 1:
            audio_np = audio_np[0]
        resampled = librosa.resample(audio_np, orig_sr=sr0, target_sr=sr1)
        return torch.from_numpy(resampled).float().unsqueeze(0).to(device)
    key = "%s-%s-%s" % (sr0, sr1, str(device))
    if key not in resample_transform_dict:
        resample_transform_dict[key] = torchaudio.transforms.Resample(sr0, sr1).to(device)
    return resample_transform_dict[key](audio_tensor)
''',
)

c = c.replace(
    "torchaudio.load(ref_audio_path)",
    "(lambda f: (lambda s,d: (torch.from_numpy(d).float().unsqueeze(0)/32768.0, s))(*__import__(\"scipy.io.wavfile\").io.wavfile.read(f)))(ref_audio_path)",
)

p.write_text(c)
PY

# 2. Setup Persistent Pretrained Models
# We reuse the host volume linking but ensure the workspace is ready
RUN rm -rf /workspace/GPT-SoVITS/GPT_SoVITS/pretrained_models && \
    ln -s /workspace/models/pretrained_models /workspace/GPT-SoVITS/GPT_SoVITS/pretrained_models

# 3. Set Environment for High-Performance Inference
ENV CUDA_VISIBLE_DEVICES=0
ENV is_half=true
ENV PYTHONPATH=/workspace/GPT-SoVITS

WORKDIR /workspace/GPT-SoVITS

# Entrypoint is moved to a script for warm-start logic
COPY scripts/sovits_bootstrap.sh /workspace/sovits_bootstrap.sh
RUN chmod +x /workspace/sovits_bootstrap.sh

ENTRYPOINT ["/workspace/sovits_bootstrap.sh"]
