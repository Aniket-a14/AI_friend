# AI Friend - Advanced/Full Image
# Version: 1.0.0
# Contains: Base + Heavy AI libraries (Whisper, OpenCV, Torch)

ARG BASE_IMAGE=ai-friend/base:v1
FROM ${BASE_IMAGE}

WORKDIR /app

# 1. Install System Deps for Vision/Audio (e.g. OpenCV runtime)
# libgl1 is already in base, but ensuring robust support for cv2
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

USER appuser

# 2. Install AI Dependencies
COPY requirements-ai.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-ai.txt
