        {
          "kind": "boundary"
        },
        {
          "kind": "must_not_match",
          "values": [
            "\\bi\\s*am\\s*(?:\\w+,?\\s*)?an?\\s*(?:\\w+\\s+)?(?:ai|artificial intelligence|language model)\\b",
            "\\bas\\s*an?\\s*ai\\b",
