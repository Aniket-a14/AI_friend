FROM rust:1-trixie AS builder

# python3/dev headers are required by pyo3 (used in the workspace Cargo structure).
# cmake + clang/libclang are required by whisper-rs, which compiles whisper.cpp
# from source and generates its FFI bindings with bindgen.
RUN apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    cmake \
    clang \
    libclang-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml ./Cargo.toml
COPY Cargo.lock ./Cargo.lock
COPY crates ./crates

# Two builds, deliberately ordered, because of a shared-library filename collision:
# ort (voice-agent) copies ITS ONNX Runtime into target/release/libonnxruntime.so,
# and sherpa-onnx (stt-agent) copies ITS OWN bundled ONNX Runtime — a different
# version — under the exact same path. In a combined build whichever crate builds
# last silently wins, and the losing agent fails at startup (or worse, misbehaves)
# while the image build stays green. Building voice-agent alone first lets us stage
# ort's pristine copy before sherpa can clobber it.
RUN cargo build --release --package voice-agent
RUN mkdir -p /staging/voice-libs \
    && cp -L /app/target/release/libonnxruntime.so* /staging/voice-libs/

RUN cargo build --release --package stt-agent
# sherpa's pristine libraries live in its own build out-dir, untouched by the
# collision above. `cp -L` materialises symlink names as real files so nothing
# dangles after the COPY into the runtime stage. The `test` lines make this fail
# loudly if the sherpa-onnx-sys layout ever changes, instead of shipping an image
# whose stt-agent cannot start.
RUN mkdir -p /staging/stt-libs \
    && find /app/target/release/build -path '*sherpa-onnx-sys*' -name '*.so*' \
       -exec cp -L {} /staging/stt-libs/ \; \
    && test -e /staging/stt-libs/libsherpa-onnx-c-api.so \
    && ls /staging/stt-libs/libonnxruntime.so* > /dev/null

FROM debian:trixie-slim AS runtime

RUN apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends ca-certificates netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/voice-agent /usr/local/bin/voice-agent
COPY --from=builder /app/target/release/stt-agent /usr/local/bin/stt-agent

# voice-agent's ONNX Runtime (ort's copy) resolves via the linker cache: ort emits
# no rpath, so /usr/local/lib + ldconfig is its lookup path.
COPY --from=builder /staging/voice-libs/ /usr/local/lib/

# stt-agent's sherpa libraries — including sherpa's own libonnxruntime.so — go NEXT
# TO THE BINARY, not into /usr/local/lib. sherpa-onnx-sys links stt-agent with
# `-rpath $ORIGIN`, so it prefers these; and because /usr/local/bin is not in the
# linker cache, voice-agent can never accidentally load sherpa's ONNX Runtime in
# place of ort's. Two agents, two ONNX Runtimes, zero ambiguity.
COPY --from=builder /staging/stt-libs/ /usr/local/bin/

RUN ldconfig

# stt-agent downloads ggml weights into STT_MODEL_DIR (/app/models/whisper) on
# first boot, and docker-compose mounts the stt_models_data volume at /app/models.
# This directory must exist *in the image*, owned by the runtime user, before the
# USER switch: when Docker seeds a fresh named volume it copies the image
# directory's ownership, but if the mountpoint does not exist in the image it
# creates it root-owned 0755 instead. `nobody` could then never write the cache,
# so ensure_model() would fail and the container would restart-loop -- with
# STT_BACKEND=whisper (the default) that means no transcription at all.
#
# models/sensevoice is the mountpoint for the host-provisioned SenseVoice model
# (backend/scripts/bootstrap/provision_models.py); it is bind-mounted read-only by
# docker-compose, so ownership only matters for the empty-dir fallback case.
RUN install -d -o nobody -g nogroup /app/models /app/models/whisper /app/models/sensevoice

USER nobody:nogroup
