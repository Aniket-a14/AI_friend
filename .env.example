# AI Friend - Infrastructure Secrets
# DO NOT COMMIT YOUR REAL .env FILE TO GIT

# 1. LIVEKIT CREDENTIALS
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
# Key/Secret pair for the server: "key: secret"
LIVEKIT_KEYS="your_livekit_key: your_livekit_secret"

# 2. DATABASE SECRETS
POSTGRES_PASSWORD=your_secure_password_here

# 3. NEO4J SECRETS (Hardened)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here
NEO4J_AUTH=neo4j/your_secure_password_here
NEO4J_PLUGINS=["apoc"]

# 4. SERVICE URLs (Local defaults - Docker overrides in compose)
NATS_URL=nats://localhost:4222
OLLAMA_URL=http://localhost:11434
SOVITS_URL=http://localhost:9871
DATABASE_URL=postgresql://ai_friend:your_secure_password_here@localhost:5432/ai_friend_db

# 5. CVS-1.0 PERFORMANCE TUNING
SYSTEM_TICK_INTERVAL=60
FEEDBACK_ALPHA=0.70
MAX_VOICE_QUEUE_SIZE=10
VOICE_SYNTH_CONCURRENCY=1
STT_WHISPER_QUEUE_SIZE=8
INTENT_THRESHOLD=0.75
STATE_SENSORY_WEIGHT=0.20

# 6. EXTERNAL API KEYS
GEMINI_API_KEY=your_gemini_key
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_KEYS="your_livekit_key: your_livekit_secret"
