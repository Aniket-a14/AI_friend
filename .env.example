# -----------------------------------------------------------------------------
# AI FRIEND — ENVIRONMENT VARIABLES
# Copy to `.env` and fill in actual values.
# DO NOT COMMIT the real `.env` files.
# -----------------------------------------------------------------------------

# LiveKit (WebRTC SFU)
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here
LIVEKIT_KEYS="your_api_key: your_api_secret"
LIVEKIT_URL=ws://local_sfu:7880

# PostgreSQL
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql://ai_friend:${POSTGRES_PASSWORD}@127.0.0.1:5432/ai_friend_db
DIRECT_URL=postgresql://ai_friend:${POSTGRES_PASSWORD}@127.0.0.1:5432/ai_friend_db

# Local LLM
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_REQUIRED_MODELS=llama3.2:3b,nomic-embed-text

# NATS
NATS_URL=nats://127.0.0.1:4222

# Pinned Infra Image Tags (stability across environments)
NATS_IMAGE_TAG=2.10.24-alpine
NEO4J_IMAGE_TAG=5.26.0
LIVEKIT_IMAGE_TAG=v1.8.4
OLLAMA_IMAGE_TAG=0.5.7

# Neo4j Knowledge Graph
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_graph_password_here
NEO4J_AUTH=neo4j/your_graph_password_here
NEO4J_PLUGINS=["apoc"]

# External APIs (Optional)
GEMINI_API_KEY=your_gemini_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
PORCUPINE_ACCESS_KEY=your_porcupine_key_here

# Agent Identity
AI_NAME="AI Friend"
LOCATION_CONTEXT="Your City, State"

# Voice Runtime
CUSTOM_GPT_PATH=GPT_weights/ai_friend_voice.ckpt
CUSTOM_SOVITS_PATH=SoVITS_weights/ai_friend_voice.pth
STT_LANGUAGE=en
# Fast-path acoustic perception. "on": use SenseVoice (emotion + audio events)
# when a model is present in STT_SENSEVOICE_DIR; "off": force the plain Whisper
# fast path (words only, no tone). Provision the model once on the host with:
#   python backend/scripts/bootstrap/provision_models.py
STT_SENSEVOICE=on
STT_SENSEVOICE_DIR=/app/models/sensevoice
TTS_LANGUAGE=en
VOICE_WEIGHT_LOAD_RETRIES=3
VOICE_FILLER_HYDRATE_ON_STARTUP=true
SAMPLE_RATE=32000
VOICE_FILLER_THRESHOLD=0.25

# Runtime Flags
RUNTIME_AUTO_BOOTSTRAP=true
RUNTIME_BOOTSTRAP_RETRIES=15
LLM_INTENT_CLASSIFICATION_ENABLED=false
REFLECTION_ENABLED=true
REFLECTION_MIN_INTERVAL_SECONDS=300
LAN_ONLY=true
# Shared secret required to mint a /token or /start-session session from any
# device other than the one running the backend (e.g. your phone over WiFi).
# Leave unset for single-machine use; required as soon as another device -
# or LAN_ONLY=false - needs to reach the backend. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_ACCESS_KEY=

# Optional GPU Hints (leave empty for macOS CPU/Metal local runs)
NVIDIA_VISIBLE_DEVICES=
NVIDIA_DRIVER_CAPABILITIES=

# Proactive Speech
PROACTIVE_ENABLED=true
PROACTIVE_IDLE_THRESHOLD_SECONDS=7200
PROACTIVE_COOLDOWN_SECONDS=3600
PROACTIVE_MIN_ENERGY=0.2

# Observability
MESH_OBSERVED_SUBJECTS=system.tick,memory.surfaced,audio.stop,audio.resume,chat.output
SUBJECT_METRICS_LOG_EVERY=25
