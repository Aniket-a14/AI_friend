# AI Friend - Infrastructure Secrets
# DO NOT COMMIT YOUR REAL .env FILE TO GIT

# 1. LIVEKIT CREDENTIALS
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
# Key/Secret pair for the server: "key: secret"
LIVEKIT_KEYS="your_livekit_key: your_livekit_secret"

# 2. DATABASE SECRETS
POSTGRES_PASSWORD=your_secure_password_here

# 3. NEO4J SECRETS (Hardened)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here
NEO4J_AUTH=neo4j/your_secure_password_here
NEO4J_PLUGINS=["apoc"]

# 4. SERVICE URLs (Local defaults - Docker overrides in compose)
NATS_URL=nats://localhost:4222
OLLAMA_URL=http://localhost:11434
SOVITS_URL=http://localhost:9871
DATABASE_URL=postgresql://ai_friend:your_secure_password_here@localhost:5432/ai_friend_db

# 5. CVS-1.0 PERFORMANCE TUNING
SYSTEM_TICK_INTERVAL=60
FEEDBACK_ALPHA=0.70
MAX_VOICE_QUEUE_SIZE=10
VOICE_SYNTH_CONCURRENCY=1
VOICE_WEIGHT_LOAD_RETRIES=3
VOICE_FILLER_HYDRATE_ON_STARTUP=true
STT_WHISPER_QUEUE_SIZE=8
INTENT_THRESHOLD=0.75
STATE_SENSORY_WEIGHT=0.20
STT_LANGUAGE=en
TTS_LANGUAGE=en
CUSTOM_GPT_PATH=GPT_weights/ai_friend_voice.ckpt
CUSTOM_SOVITS_PATH=SoVITS_weights/ai_friend_voice.pth
RUNTIME_AUTO_BOOTSTRAP=true
RUNTIME_BOOTSTRAP_RETRIES=15
OLLAMA_REQUIRED_MODELS=llama3.2:1b,nomic-embed-text
LLM_INTENT_CLASSIFICATION_ENABLED=false
REFLECTION_ENABLED=true
REFLECTION_MIN_INTERVAL_SECONDS=300
MESH_OBSERVED_SUBJECTS=system.tick,memory.surfaced,audio.stop,audio.resume,chat.output
SUBJECT_METRICS_LOG_EVERY=25

# 6. EXTERNAL API KEYS
GEMINI_API_KEY=your_gemini_key
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_KEYS="your_livekit_key: your_livekit_secret"
